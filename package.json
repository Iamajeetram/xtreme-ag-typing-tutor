{
  "name": "ag-typing-tutor",
  "productName": "AG Typing Tutor",
  "version": "1.0.0",
  "description": "AG Typing Tutor & RSSB LDC Exam Simulator by Xtreme AG Apps",
  "author": "Xtreme AG Apps",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-dist.cjs",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.xtremeag.typingtutor",
    "productName": "AG Typing Tutor",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/AG-Typing-Tutor-Icon-512.png",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/AG-Typing-Tutor-Icon-512.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AG Typing Tutor",
      "artifactName": "AG-Typing-Tutor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AG-Typing-Tutor-Portable-${version}.${ext}"
    }
  }
}
