{
  "name": "ag-typing-tutor",
  "productName": "AG Typing Tutor",
  "version": "1.2.0",
  "description": "AG Typing Tutor & RSSB LDC Exam Simulator by Xtreme AG Apps",
  "author": "Xtreme AG Apps",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-dist.cjs",
    "preview": "vite preview",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never && node scripts/sign-mac.cjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.xtremeag.typingtutor",
    "productName": "AG Typing Tutor",
    "publish": null,
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "app_dist/**/*",
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "AG-Typing-Tutor-Mac-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "publisherName": "Xtreme AG Apps",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AG Typing Tutor",
      "artifactName": "AG-Typing-Tutor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AG-Typing-Tutor-Portable-${version}.${ext}"
    }
  }
}
